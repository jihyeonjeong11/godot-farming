      "text": "\n#include \"auto_note.h\" - 노트 기록\n#include \"avatar.h\" - 플레이어\n#include \"calendar.h\" - 시간 달력\n#include \"cata_assert.h\" - 디버깅용\n#include \"cata_path.h\" - 파일 위치\n#include \"cata_utility.h\" - 윺틸\n#include \"character_id.h\" - 캐릭터 id 필요할지도\n#include \"coordinates.h\" - 타일 좌표\n#include \"cuboid_rectangle.h\"\n#include \"debug.h\"\n#include \"dialogue.h\" - 대화 관련?\n#include \"effect_on_condition.h\"\n#include \"filesystem.h\" - json 로드\n#include \"flood_fill.h\"\n#include \"game.h\"\n#include \"horde_entity.h\"\n#include \"line.h\"\n#include \"map.h\"\n#include \"map_extras.h\"\n#include \"map_iterator.h\"\n#include \"mapbuffer.h\"\n#include \"mapgen_post_process.h\"\n#include \"math_defines.h\"\n#include \"messages.h\"\n#include \"mongroup.h\"\n#include \"monster.h\"\n#include \"mtype.h\"\n#include \"npc.h\"\n#include \"options.h\"\n#include \"overmap_connection.h\"\n#include \"overmap_map_data_cache.h\"\n#include \"overmap_noise.h\"\n#include \"overmap_types.h\"\n#include \"overmapbuffer.h\"\n#include \"path_info.h\"\n#include \"regional_settings.h\"\n#include \"rng.h\"\n#include \"rotatable_symbols.h\"\n#include \"sets_intersect.h\"\n#include \"simple_pathfinding.h\"\n#include \"string_formatter.h\"\n#include \"talker.h\"\n#include \"text_snippets.h\"\n#include \"translations.h\"\n#include \"worldfactory.h\"\n#include \"zzip.h\"\n",
