      "link": null,
      "locked": false,
      "text": "STEP4: lay_out_street(source: p, dir: dir, length: cs + 1)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STEP4: lay_out_street(source: p, dir: dir, length: cs + 1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_k1fcibxSIsTT8KiUB2kG",
      "type": "text",
      "x": 1739.511972754128,
      "y": 649.549505030694,
      "width": 753.7877197265625,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5s",
      "roundness": null,
      "seed": 504927152,
      "version": 30,
      "versionNonce": 1033829481,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788322893972,
      "link": null,
      "locked": false,
      "text": "        var c := cs\n        var croad := cs\n\n        var street_path := lay_out_street(p, dir, cs + 1)\n            if street_path.size() <= 1:\n                return  # Don't bother.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "        var c := cs\n        var croad := cs\n\n        var street_path := lay_out_street(p, dir, cs + 1)\n            if street_path.size() <= 1:\n                return  # Don't bother.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zjXh9TWyTvbdkhH7Hw-9N",
      "type": "text",
      "x": 1746.6548298969851,
      "y": 1203.8352193164083,
      "width": 870.2679443359375,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5u",
      "roundness": null,
      "seed": 1335879600,
      "version": 28,
      "versionNonce": 757865127,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788322893972,
      "link": null,
      "locked": false,
      "text": "        # 한 칸 더 가면 기존 도로에 닿는 경우 — 끊기지 않게 붙여준다.\n        var en_pos := source + DIR_VEC[dir] * (length + 1)\n        if inbounds(en_pos, 1) and is_road(en_pos):\n                length += 1\n\n        var actual_len := 0\n        while actual_len < length:\n                var pos := source + DIR_VEC[dir] * actual_len\n                if not valid_placement(pos, dir):\n                        break\n                actual_len += 1\n                if actual_len > 1 and is_road(pos):\n                        break  # Stop here. 이미 있는 도로에 닿았다.\n\n        var path: Array[Vector2i] = []\n        for i in actual_len:\n                path.append(source + DIR_VEC[dir] * i)\n        return path",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "        # 한 칸 더 가면 기존 도로에 닿는 경우 — 끊기지 않게 붙여준다.\n        var en_pos := source + DIR_VEC[dir] * (length + 1)\n        if inbounds(en_pos, 1) and is_road(en_pos):\n                length += 1\n\n        var actual_len := 0\n        while actual_len < length:\n                var pos := source + DIR_VEC[dir] * actual_len\n                if not valid_placement(pos, dir):\n                        break\n                actual_len += 1\n                if actual_len > 1 and is_road(pos):\n                        break  # Stop here. 이미 있는 도로에 닿았다.\n\n        var path: Array[Vector2i] = []\n        for i in actual_len:\n                path.append(source + DIR_VEC[dir] * i)\n        return path",
      "autoResize": true,
      "lineHeight": 1.25
    },
