    {
      "id": "srPhN3Ml15TvgJrYIf1U3",
      "type": "text",
      "x": -1128.517790666824,
      "y": 652.8101385755149,
      "width": 723.27294921875,
      "height": 418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5R",
