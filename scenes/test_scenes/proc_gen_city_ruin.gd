extends Node2D

const MAP_SIZE := 180

enum Direction {
	West,
	East,
	North,
	South
}

var settings: Dictionary = {}

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	settings.set("city_size", 8)
	settings.set("urbanity", 50)
	#settings.set("overmap_highway", )
	build_city(Direction.West)
	
func build_city(dir: Direction) -> void:
	var p := Vector2i(MAP_SIZE / 2, MAP_SIZE / 2)
	var street_path = layout_street(p, dir, settings.get("city_size") + 1)
	
