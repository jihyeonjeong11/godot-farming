      "text": "STEP2: build_city()",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STEP2: build_city()",
      "autoResize": true,
