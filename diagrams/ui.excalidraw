    },
    {
      "id": "Uz_wlnyR6a_ufu53C5Evy",
      "type": "text",
      "x": 622.4515653880577,
      "y": 652.204266935456,
      "width": 943.263671875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5j",
      "roundness": null,
      "seed": 1967988048,
      "version": 49,
      "versionNonce": 240641575,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788322893972,
      "link": null,
      "locked": false,
      "text": "city_pos = Vector2i(OMAP_SIZE / 2, OMAP_SIZE / 2)\ngrid[city_pos] = Cell.ROAD  # every city starts with an intersection\n\nvar start_dir := rng.randi_range(0, 3)\nvar cur_dir := start_dir\nwhile true:\n  build_city_street(city_pos, city_size, cur_dir)\n  cur_dir = turn_right(cur_dir)\n  if cur_dir == start_dir:\n       break",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "city_pos = Vector2i(OMAP_SIZE / 2, OMAP_SIZE / 2)\ngrid[city_pos] = Cell.ROAD  # every city starts with an intersection\n\nvar start_dir := rng.randi_range(0, 3)\nvar cur_dir := start_dir\nwhile true:\n  build_city_street(city_pos, city_size, cur_dir)\n  cur_dir = turn_right(cur_dir)\n  if cur_dir == start_dir:\n       break",
      "autoResize": true,
      "lineHeight": 1.25
