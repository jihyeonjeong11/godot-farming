      "seed": 1969119152,
      "version": 100,
      "versionNonce": 800355303,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788322893972,
      "link": null,
      "locked": false,
      "text": "const OMAP_SIZE := 40\nconst CELL := 16  \nconst TILE_SIZE := 32\nconst ROAD_W := 6           # Road size = 32 * 6\nconst WALK_W := 2           # Sidewalk size = 32 * 2\nconst PAINT_MARGIN := 2     # 32 * 2\nconst BUILDING_CHANCE := 4  # 1/4 25%\n\n@export var world_seed: int = 0         \n@export var city_size: int = 8\n\nvar grid : Dictionary = {} ## City roads map!",
      "fontSize": 27.86666666666667,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const OMAP_SIZE := 40\nconst CELL := 16  \nconst TILE_SIZE := 32\nconst ROAD_W := 6           # Road size = 32 * 6\nconst WALK_W := 2           # Sidewalk size = 32 * 2\nconst PAINT_MARGIN := 2     # 32 * 2\nconst BUILDING_CHANCE := 4  # 1/4 25%\n\n@export var world_seed: int = 0         \n@export var city_size: int = 8\n\nvar grid : Dictionary = {} ## City roads map!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ascii-map-box-01",
      "x": -1569,
