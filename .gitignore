export_presets.cfg
/build/
/builds/
/export/
/exports/
*.pck
*.zip
*.exe
*.x86_64
*.apk
*.aab
*.dmg
*.app
*.wasm

# Android keystores / signing
*.keystore
*.jks

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
